# Copy this file to .env.local (already gitignored) and fill in real values.
# Never commit .env.local or paste its contents in chat.

# Supabase — Project Settings → Database → Connection string → "Transaction" mode (port 6543).
# Project ref for this project: xfrzdlogwcqqpgdadmni
# Replace [REGION] and [YOUR-PASSWORD] with the real values shown in that dashboard page.
DATABASE_URL="postgres://postgres.xfrzdlogwcqqpgdadmni:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Better Auth session-signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Analytics (optional — see src/components/analytics/gtag.ts).
# GTM container ID from tagmanager.google.com — GA4/other tags are then
# configured inside the GTM container itself, not in this codebase.
NEXT_PUBLIC_GTM_ID=""

# YouTube sync job (only needed to run scripts/sync-youtube.ts)
YOUTUBE_API_KEY=""

# AI review of new videos in the sync/discovery jobs (optional). Without
# credentials new videos are added as pending with no AI review or summary.
# Never paste these in chat or commit them.
# Option A (no API credit): a Claude subscription token for the Claude Code
# CLI — generate it with `claude setup-token` and install the CLI on the host.
CLAUDE_CODE_OAUTH_TOKEN=""
# CLAUDE_BIN="/full/path/to/claude"   # if `claude` isn't on the cron PATH
# Option B: Anthropic API key (needs API credit).
ANTHROPIC_API_KEY=""
# AI_REVIEW_BACKEND="cli"             # force "cli" or "api" when both are set
# AI_REVIEW_MODEL="sonnet"            # cli: alias; api: e.g. "claude-opus-5"

# Admin identity — used both for the seeded admin login and as the
# recipient for suggestion/digest notification emails.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Email (optional — see src/lib/email/send.ts). Same Resend account used
# by the other raspi apps. Missing/empty disables email — the /sugerir
# form still saves to the DB either way, it just won't notify by mail.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Advertising (optional — see src/components/ads/AdSlot.tsx). Empty
# disables ads entirely (renders nothing, no broken placeholder). Both
# require applying for AdSense and being approved first.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# Ad unit id for the home page slot (created in the AdSense dashboard
# once approved) — a separate env var per placement, so adding more
# later needs no code change.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""

# Adsterra units (keys in src/components/ads/adsterra.ts). "1" turns them
# all off; they otherwise load only after consent in the TCF banner.
NEXT_PUBLIC_ADSTERRA_DISABLED=""
