# Copy this file to .env.local (already gitignored) and fill in real values.
# Never commit .env.local or paste its contents in chat.

# Supabase — Project Settings → Database → Connection string → "Transaction" mode (port 6543).
# Project ref for this project: xfrzdlogwcqqpgdadmni
# Replace [REGION] and [YOUR-PASSWORD] with the real values shown in that dashboard page.
DATABASE_URL="postgres://postgres.xfrzdlogwcqqpgdadmni:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Better Auth session-signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Analytics (optional — see src/components/analytics/gtag.ts).
# GTM container ID from tagmanager.google.com — GA4/other tags are then
# configured inside the GTM container itself, not in this codebase.
NEXT_PUBLIC_GTM_ID=""

# YouTube sync job (only needed to run scripts/sync-youtube.ts)
YOUTUBE_API_KEY=""

# Admin identity — used both for the seeded admin login and as the
# recipient for suggestion/digest notification emails.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Email (optional — see src/lib/email/send.ts). Same Resend account used
# by the other raspi apps. Missing/empty disables email — the /sugerir
# form still saves to the DB either way, it just won't notify by mail.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
